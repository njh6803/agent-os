          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "reason"
        ],
        "title": "UnreadableManifest",
        "type": "object"
      },
      "UnreadableTrace": {
        "additionalProperties": false,
        "description": "트레이스로 읽히지 않는 것의 표지. 실행 식별자와 이유를 든다. 실행 요약이 아니다.",
        "properties": {
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "run_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "reason"
        ],
        "title": "UnreadableTrace",
        "type": "object"
      },
      "Violation": {
        "additionalProperties": false,
        "description": "형식 오류 하나. field 는 `query.limit` 처럼 점으로 이은 경로 문자열이다.",
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "Violation",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "관리는 등록된 플러그인과 지나간 실행을 읽고 실행을 일으키지 않는다. 채널은 실행을 일으켜 그 이벤트 스트림을 돌려준다. 두 면은 서로 다른 토큰으로 연다.",
    "title": "Agent OS HTTP API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "read_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "서버가 요청을 처리하지 못했다"
          }
        },
        "summary": "살아 있는지만 답한다"
      }
    },
    "/plugins": {
      "get": {
        "operationId": "list_plugins",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PluginRow"
                  },
                  "title": "Response List Plugins",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "토큰이 없거나 틀리다"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "서버가 요청을 처리하지 못했다"
          }
        },
        "summary": "등록된 플러그인 전부를 종류를 가리지 않고 한 목록으로"
      }
    },
    "/plugins/{kind}/{name}": {
      "get": {
        "operationId": "read_plugin",
        "parameters": [
          {
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PluginKind"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "pattern": "^[a-z][a-z0-9-]{1,62}$",
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PluginManifest"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "토큰이 없거나 틀리다"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "찾는 것이 없다"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "요청의 형식이 올바르지 않다"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "서버가 요청을 처리하지 못했다"
          }
        },
        "summary": "플러그인 하나의 매니페스트를 통째로"
      }
    },
    "/runs": {
      "post": {
        "operationId": "start_run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRun"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "properties": {
                    "data": {
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "$ref": "#/components/schemas/Event"
                      },
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "토큰이 없거나 틀리다"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "찾는 것이 없다"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "요청의 형식이 올바르지 않다"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "서버가 요청을 처리하지 못했다"
          }
        },
        "summary": "실행 하나를 일으켜 그 이벤트를 생기는 대로 흘린다"
      }
    },
    "/traces": {
      "get": {
        "operationId": "list_traces",
        "parameters": [
          {
            "description": "없으면 전부다. paused 가 곧 멈춘 실행 목록이다",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RunStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "없으면 전부다. paused 가 곧 멈춘 실행 목록이다",
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "앞 쪽의 next_cursor 를 그대로 넘긴다",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9_-]{1,256}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "앞 쪽의 next_cursor 를 그대로 넘긴다",
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TracePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "토큰이 없거나 틀리다"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "요청의 형식이 올바르지 않다"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "서버가 요청을 처리하지 못했다"
          }
        },
        "summary": "지나간 실행의 요약을 최근 것부터 한 쪽씩"
      }
    },
    "/traces/{run_id}": {
      "get": {
        "operationId": "read_trace",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trace"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "토큰이 없거나 틀리다"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "찾는 것이 없다"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "요청의 형식이 올바르지 않다"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "서버가 요청을 처리하지 못했다"
          }
        },
        "summary": "한 실행의 이벤트 전부를 쓴 순서 그대로"
      }
    }
  }
}
