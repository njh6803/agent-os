# 환경 변수 틀. 이 파일을 .env 로 복사해 채운다. 비밀 값이 들므로 운영자만 읽게 둔다(chmod 600).
# 판 번호와 이미지 이름공간은 판을 낼 때 채워져 있다. 끝자리만 오른 판으로 올릴 때는 AGENT_OS_VERSION 한 줄만 바꾼다.
AGENT_OS_VERSION=@AGENT_OS_VERSION@
AGENT_OS_NAMESPACE=@AGENT_OS_NAMESPACE@

# 데이터베이스 비밀번호. openssl rand -hex 32 로 만든 값(영문자와 숫자)을 쓴다. 처음 띄울 때 데이터베이스에
# 정해지므로, 그 뒤에 이 줄만 바꾸면 접속하지 못한다. 바꿀 때는 배포 안내의 "데이터베이스 비밀번호 바꾸기"를 따른다.
AGENT_OS_DATABASE_PASSWORD=

# 기본 모델 플러그인의 이름과 모델 제공사의 API 키.
AGENT_OS_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
