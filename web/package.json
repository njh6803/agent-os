{
  "name": "agent-os-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "verify": "pnpm run check:api-client && pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test && pnpm run check:tsconfig",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --check . --ignore-path ../.gitignore --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit && pnpm -r exec tsc --noEmit && tsc --noEmit -p packages/ui/visual",
    "test": "vitest run",
    "visual": "node tools/visual.ts packages/ui",
    "visual:update": "node tools/visual.ts packages/ui --update",
    "check:tsconfig": "node tools/check-tsconfig.ts",
    "generate:api-client": "node tools/generate-api-client.ts",
    "check:api-client": "node tools/generate-api-client.ts --check"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^24.19.0",
    "@vitest/browser-playwright": "5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "storybook": "^10.6.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
