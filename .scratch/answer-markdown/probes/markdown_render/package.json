{
  "name": "md-probe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "node probe/typecheck.mjs",
    "deps": "node probe/deps.mjs",
    "registry": "node probe/registry.mjs",
    "render": "node probe/render.mjs && node probe/report.mjs",
    "size": "node probe/size.mjs",
    "lint": "node probe/lint.mjs",
    "stress": "node probe/stress.mjs"
  },
  "dependencies": {
    "markdown-to-jsx": "9.10.6",
    "marked": "18.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-boundaries": "7.2.0",
    "parse5": "8.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1"
  }
}
