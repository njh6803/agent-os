+// [프로브 판] release-image 설계 인터뷰의 widget_runtime 프로브가 실험으로 둔 파일이다. 반영할 코드가 아니다. 워크스페이스의
+// ESLint 는 이 이름의 파일을 막는다(ADR 0019 의 서버 파일 금지).
+//
+// 페이지 안 번들(element.js)이 실행 중의 요청 글자 수 상한을 위젯 출처에서 받아 오는 길의 서버 쪽 절반이다. 사이트
+// 문서에서 부르므로 자격 증명 없이 받는 공개 값으로 내고 Access-Control-Allow-Origin 을 * 로 단다. 허용 출처는 싣지
+// 않는다(페이지 안 방식은 postMessage 를 쓰지 않는다). 경로는 basePath 아래의 /widget/config 다.
+
+import { buildInput } from "@agent-os/site-file";
+import { connection } from "next/server";
+
+export async function GET(): Promise<Response> {
+  await connection();
+  const { requestChars } = buildInput(process.env);
+  return Response.json({ requestChars }, { headers: { "Access-Control-Allow-Origin": "*" } });
+}
