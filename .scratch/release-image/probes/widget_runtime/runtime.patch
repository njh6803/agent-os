diff --git a/web/apps/widget/proxy.ts b/web/apps/widget/proxy.ts
new file mode 100644
index 000000000..5242c8bc1
--- /dev/null
+++ b/web/apps/widget/proxy.ts
@@ -0,0 +1,21 @@
+// [프로브 판] release-image 설계 인터뷰의 widget_runtime 프로브가 실험으로 둔 파일이다. 반영할 코드가 아니다. 워크스페이스의
+// ESLint 는 이 이름의 파일을 막는다(ADR 0019 의 서버 파일 금지).
+//
+// iframe 페이지(/widget)의 응답에 `frame-ancestors` 를 요청마다 사이트 파일에서 읽어 단다. 읽는 규칙은 빌드가 쓰던 것과
+// 같다(`@agent-os/site-file` 의 `buildInput`). 변수가 없으면 'none' 이고, 변수가 가리키는 파일을 읽지 못하면 던진다.
+// matcher 의 경로에는 basePath 가 저절로 붙는다(Next 16.3.6 의 build/analysis/get-page-static-info.js).
+
+import { buildInput } from "@agent-os/site-file";
+import { NextResponse } from "next/server";
+
+export function proxy(): NextResponse {
+  const { allowedOrigins } = buildInput(process.env);
+  const ancestors = allowedOrigins.length === 0 ? "'none'" : allowedOrigins.join(" ");
+  const response = NextResponse.next();
+  response.headers.set("Content-Security-Policy", `frame-ancestors ${ancestors}`);
+  return response;
+}
+
+export const config = {
+  matcher: ["/"],
+};
