"""공개 경로가 데이터베이스에 넣은 값을 싣는다(프로브의 장난감)."""

from __future__ import annotations

import httpx
from sqlalchemy import text
from tools.database_for_tests import ScopedDatabase

from widget_admin.app import create_app
from widget_admin.database import engine_for


async def test_넣은_설정이_공개_경로의_답에_실린다(database: ScopedDatabase) -> None:
    print(f"PROBE-DATABASE {database.name}")
    engine = engine_for(database.text())
    try:
        async with engine.begin() as connection:
            await connection.execute(
                text("INSERT INTO widget_settings (site, heading) VALUES ('acme', '안녕')")
            )
    finally:
        await engine.dispose()
    app = create_app(database.text())
    transport = httpx.ASGITransport(app=app)
    async with httpx.AsyncClient(transport=transport, base_url="http://probe") as client:
        found = await client.get("/widget-settings/acme")
        missing = await client.get("/widget-settings/nobody")

    assert database.name.startswith("widget_admin_test_")
    assert found.status_code == 200
    assert found.json() == {"schema_version": 1, "heading": "안녕"}
    assert missing.status_code == 404
