+// 모듈에서 쓰던 규칙을 낸다. 화면 부품이 대화의 모양(lib/conversation)과 상한·재접속의 글(lib/limit, lib/reconnect)을
+// 타입과 함수로 읽어, 그 모듈들이 부품과 함께 왔다. 쓰는 앱은 이 파일과 `./source.css` 를 패키지 이름으로 import 한다.
+export {
+  WidgetScreen,
+  type Restore,
+  type WidgetScreenProps,
+} from "./components/pages/WidgetScreen";
+export {
+  INITIAL,
+  phaseOf,
+  reduce,
+  waitingApproval,
+  type Action,
+  type Announcement,
+  type Approval,
+  type ApprovalState,
+  type Conversation,
+  type Decision,
+  type DecisionNotice,
+  type Exchange,
+  type FailureCause,
+  type Outcome,
+  type ToolCall,
+} from "./lib/conversation";
+export { remainingAt, startWait, untilNextTick, type LimitWait } from "./lib/limit";
+export { endingOf, reconnectDelay, SILENCE_MS, type Reconnect } from "./lib/reconnect";
