index 000000000..952558af7
--- /dev/null
+++ b/web/apps/admin/components/pages/WidgetPreviewProbe.stories.tsx
@@ -0,0 +1,61 @@
+// (portal-admin 의 프로브 shared_widget_parts 가 둔 임시 파일. 병합하지 않는다.) 관리 화면의 Storybook 에서 위젯 화면 부품이
+// 서는지 본다. 미리보기의 afterEach 가 그린 클래스마다 관리 화면의 CSS 에 규칙이 있는지 판정하고, addon-a11y 가 관리 화면의
+// 설정(target-size 포함)으로 axe 를 돈다. 사진 비교에는 들지 않게 `judgment` 를 단다(관리 화면의 정답 사진을 더하지 않는다).
+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { expect, within } from "storybook/test";
+import { AdminFrame } from "../templates/AdminFrame";
+import { WidgetPreviewProbe } from "./WidgetPreviewProbe";
+
+const meta = {
+  title: "pages/WidgetPreviewProbe",
+  component: WidgetPreviewProbe,
+  tags: ["judgment"],
+} satisfies Meta<typeof WidgetPreviewProbe>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+/** 틀 없이 그린 위젯 화면. */
+export const Standalone: Story = {
+  play: async ({ canvasElement }) => {
+    const canvas = within(canvasElement);
+    const heading = canvas.getByRole("heading", { name: "주문 도우미" });
+    // `overflow-y-auto` 는 관리 화면과 디자인 시스템의 소스에 없고 위젯 화면 부품의 소스에만 있는 클래스다. 관리 화면의
+    // CSS 가 그 패키지의 소스를 덮어야 규칙이 선다(덮지 않으면 미리보기의 클래스 판정이 이 클래스를 포함해 열을 든다).
+    await expect(getComputedStyle(canvas.getByRole("main")).overflowY).toBe("auto");
+    // 감싼 요소의 보통 밀도(15px)가 창 폭이 고른 밀도를 이긴다. 넓은 창의 문서 뿌리는 촘촘(14px)이다.
+    await expect(getComputedStyle(heading).fontSize).toBe("15px");
+    await expect(canvas.getByText("배송 중")).toBeVisible();
+  },
+};
+
+/** 문서는 밝은데 감싼 요소만 어둡다. 위젯 창의 바탕이 감싼 요소의 밝기를 따른다. */
+export const Dark: Story = {
+  args: { mode: "dark" },
+  play: async ({ canvasElement }) => {
+    const canvas = within(canvasElement);
+    const wrapper = canvas.getByRole("heading", { name: "주문 도우미" }).closest("[data-mode]");
+    if (!(wrapper instanceof HTMLElement) || !(wrapper.firstElementChild instanceof HTMLElement)) {
+      throw new Error("감싼 요소와 위젯 창을 찾지 못했다");
+    }
+    const frame = wrapper.firstElementChild;
+    // 문서 뿌리는 모드를 달지 않아 브라우저의 설정(시험 브라우저는 밝음)을 따른다.
+    await expect(getComputedStyle(document.documentElement).colorScheme).toBe("light");
+    await expect(getComputedStyle(wrapper).colorScheme).toBe("dark");
+    const dark = getComputedStyle(frame).backgroundColor;
+    wrapper.dataset.mode = "light";
+    const light = getComputedStyle(frame).backgroundColor;
+    wrapper.dataset.mode = "dark";
+    await expect(dark).not.toBe(light);
+  },
+};
+
+/** 관리 화면의 틀 안에 둔 위젯 화면. 틀의 `main` 과 화면의 `h1` 안쪽에 위젯의 `main` 과 `h1` 이 든다. */
+export const InAdminFrame: Story = {
+  render: () => (
+    <AdminFrame nav={null}>
+      <h1 className="text-title">사이트 고치기</h1>
+      <WidgetPreviewProbe />
+    </AdminFrame>
+  ),
+};
diff --git a/web/apps/admin/components/pages/WidgetPreviewProbe.tsx b/web/apps/admin/components/pages/WidgetPreviewProbe.tsx
new file mode 100644
index 000000000..a9e9a30d3
--- /dev/null
+++ b/web/apps/admin/components/pages/WidgetPreviewProbe.tsx
@@ -0,0 +1,64 @@
+"use client";
+
+// (portal-admin 의 프로브 shared_widget_parts 가 둔 임시 파일. 병합하지 않는다.) 다른 앱이 `@agent-os/widget-ui` 의
+// `WidgetScreen` 을 값만 주어 그릴 수 있는지 본다. 서버에 묻지 않고 처리기는 아무것도 하지 않는다. 위젯이 문서 뿌리나
+// shadow 호스트에 다는 테마·모드·보통 밀도를 여기서는 감싼 요소에 단다. 관리 화면의 문서 뿌리는 밀도를 달지 않아 창 폭이
+// 고른다.
+//
+// 앱의 전역 CSS 와 글꼴 CSS 는 AdminScreen 처럼 여기서 싣는다. 이 화면은 AdminScreen 을 지나지 않는다.
+import "@agent-os/ui/fonts.css";
+import "../../styles/admin.css";
+import { WidgetScreen, type Exchange } from "@agent-os/widget-ui";
+
+const EXCHANGES: readonly Exchange[] = [
+  {
+    id: 0,
+    request: "주문 1234 는 어디쯤인가요?",
+    runId: "run-preview",
+    calling: [],
+    tools: [{ tool: "orders.find", ok: true }],
+    approvals: [],
+    outcome: { kind: "finished", output: "**배송 중**입니다. 내일 도착합니다." },
+  },
+];
+
+const ignore = () => {};
+
+export interface WidgetPreviewProbeProps {
+  /** 감싼 요소에 다는 밝기. 문서 뿌리의 밝기와 달라도 위젯만 이 밝기로 칠해지는지 본다. */
+  readonly mode?: "light" | "dark";
+}
+
+export function WidgetPreviewProbe({ mode = "light" }: WidgetPreviewProbeProps) {
+  return (
+    <div
+      data-theme="nokcheong"
+      data-mode={mode}
+      data-density="regular"
+      style={{ maxWidth: 320, height: 560 }}
+    >
+      <WidgetScreen
+        heading="주문 도우미"
+        intro="주문, 배송, 환불을 물어볼 수 있습니다."
+        misconfigured={false}
+        exchanges={EXCHANGES}
+        restarted={false}
+        announcements={[]}
+        sendBlocked={false}
+        wait={null}
+        invalid={false}
+        paused={false}
+        onDecide={ignore}
+        newConversationDisabled={false}
+        draft=""
+        onDraftChange={ignore}
+        onSend={ignore}
+        onRetry={ignore}
+        onNewConversation={ignore}
+        requestChars={20_000}
+        restore="ready"
+        reconnect={null}
+      />
+    </div>
+  );
+}
