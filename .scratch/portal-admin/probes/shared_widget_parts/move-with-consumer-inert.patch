+import { WidgetPreviewProbe } from "../../components/pages/WidgetPreviewProbe";
+
+export default function Page() {
+  return <WidgetPreviewProbe />;
+}
diff --git a/web/apps/admin/components/pages/WidgetPreviewProbe.stories.tsx b/web/apps/admin/components/pages/WidgetPreviewProbe.stories.tsx
new file mode 100644
index 000000000..3d9713b3e
--- /dev/null
+++ b/web/apps/admin/components/pages/WidgetPreviewProbe.stories.tsx
@@ -0,0 +1,256 @@
+// (portal-admin 의 프로브 shared_widget_parts 가 둔 임시 파일. 병합하지 않는다.) 관리 화면의 Storybook 에서 위젯 화면 부품이
+// 서는지 본다. 미리보기의 afterEach 가 그린 클래스마다 관리 화면의 CSS 에 규칙이 있는지 판정하고, addon-a11y 가 관리 화면의
+// 설정(target-size 포함)으로 axe 를 돈다. 사진 비교에는 들지 않게 `judgment` 를 단다(관리 화면의 정답 사진을 더하지 않는다).
+import { Button } from "@agent-os/ui";
+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { expect, userEvent, within } from "storybook/test";
+import { AdminFrame } from "../templates/AdminFrame";
+import {
+  PREVIEW_LABEL,
+  WidgetPreviewProbe,
+  type WidgetPreviewProbeProps,
+} from "./WidgetPreviewProbe";
+
+const meta = {
+  title: "pages/WidgetPreviewProbe",
+  component: WidgetPreviewProbe,
+  tags: ["judgment"],
+} satisfies Meta<typeof WidgetPreviewProbe>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+/** 틀 없이 그린 위젯 화면. */
+export const Standalone: Story = {
+  play: async ({ canvasElement }) => {
+    const canvas = within(canvasElement);
+    const heading = canvas.getByRole("heading", { name: "주문 도우미" });
+    // `overflow-y-auto` 는 관리 화면과 디자인 시스템의 소스에 없고 위젯 화면 부품의 소스에만 있는 클래스다. 관리 화면의
+    // CSS 가 그 패키지의 소스를 덮어야 규칙이 선다(덮지 않으면 미리보기의 클래스 판정이 이 클래스를 포함해 열을 든다).
+    await expect(getComputedStyle(canvas.getByRole("main")).overflowY).toBe("auto");
+    // 감싼 요소의 보통 밀도(15px)가 창 폭이 고른 밀도를 이긴다. 넓은 창의 문서 뿌리는 촘촘(14px)이다.
+    await expect(getComputedStyle(heading).fontSize).toBe("15px");
+    await expect(canvas.getByText("배송 중")).toBeVisible();
+  },
+};
+
+/** 문서는 밝은데 감싼 요소만 어둡다. 위젯 창의 바탕이 감싼 요소의 밝기를 따른다. */
+export const Dark: Story = {
+  args: { mode: "dark" },
+  play: async ({ canvasElement }) => {
+    const canvas = within(canvasElement);
+    const wrapper = canvas.getByRole("heading", { name: "주문 도우미" }).closest("[data-mode]");
+    if (!(wrapper instanceof HTMLElement) || !(wrapper.firstElementChild instanceof HTMLElement)) {
+      throw new Error("감싼 요소와 위젯 창을 찾지 못했다");
+    }
+    const frame = wrapper.firstElementChild;
+    // 문서 뿌리는 모드를 달지 않아 브라우저의 설정(시험 브라우저는 밝음)을 따른다.
+    await expect(getComputedStyle(document.documentElement).colorScheme).toBe("light");
+    await expect(getComputedStyle(wrapper).colorScheme).toBe("dark");
+    const dark = getComputedStyle(frame).backgroundColor;
+    wrapper.dataset.mode = "light";
+    const light = getComputedStyle(frame).backgroundColor;
+    wrapper.dataset.mode = "dark";
+    await expect(dark).not.toBe(light);
+  },
+};
+
+// 아래 넷은 관리 화면의 틀 안, 화면의 `h1` 과 양식을 대신하는 단추 사이에 위젯 화면을 둔 모양이다. 가리는 방법만 다르다.
+
+const FOCUSABLE = "button, textarea, input, select, a[href], [tabindex]";
+
+function framed(args: WidgetPreviewProbeProps) {
+  return (
+    <AdminFrame nav={null}>
+      <h1 className="text-title">사이트 고치기</h1>
+      <WidgetPreviewProbe {...args} />
+      <Button variant="secondary">저장</Button>
+    </AdminFrame>
+  );
+}
+
+/**
+ * 가렸든 아니든 위젯이 눈에 그려졌다는 표지를 보고 감싼 요소를 돌려준다. 가린 갈래는 역할로 찾지 못하므로 DOM 에서 바로
+ * 찾는다. 빈 화면이 axe 를 지난 것과 가르는 단언이다.
+ */
+async function drawnWidget(canvasElement: HTMLElement): Promise<HTMLElement> {
+  const wrapper = canvasElement.querySelector("[data-density]");
+  const main = wrapper?.querySelector("main");
+  const heading = wrapper?.querySelector("h1");
+  if (
+    !(wrapper instanceof HTMLElement) ||
+    !(main instanceof HTMLElement) ||
+    !(heading instanceof HTMLElement)
+  ) {
+    throw new Error("위젯의 감싼 요소와 main 과 제목을 찾지 못했다");
+  }
+  const box = main.getBoundingClientRect();
+  await expect(getComputedStyle(main).overflowY).toBe("auto");
+  await expect(box.width).toBeGreaterThan(0);
+  await expect(box.height).toBeGreaterThan(0);
+  await expect(heading.textContent).toBe("주문 도우미");
+  await expect(getComputedStyle(heading).fontSize).toBe("15px");
+  return wrapper;
+}
+
+/**
+ * Tab 을 위젯 안의 포커스 가능한 요소 수보다 셋 더 누르고, 포커스가 위젯 안에 든 횟수와 "저장" 단추에 닿았는지를 낸다.
+ *
+ * `userEvent.tab()` 은 브라우저의 Tab 이 아니라 흉내다. 다음 요소를 스스로 고르는데 `inert` 를 보지 않는다(Storybook
+ * 10.6.1 의 `dist/test/index.js` 14623~14659줄의 `getTabDestination` 을 읽었다). `inert` 인 요소를 고르면 브라우저가 그
+ * `focus()` 를 받지 않아 포커스가 body 에 머문다. 그래서 `inert` 갈래에서 "저장"에 닿는지는 이 흉내로 보지 못하고, 실제 Tab
+ * 은 프로브 `preview_shield.mjs` 가 누른다.
+ */
+async function tabThrough(wrapper: HTMLElement): Promise<{ inside: number; reachedSave: boolean }> {
+  const focusable = wrapper.querySelectorAll(FOCUSABLE).length;
+  await expect(focusable).toBeGreaterThan(0);
+  let inside = 0;
+  let reachedSave = false;
+  for (let press = 0; press < focusable + 3; press += 1) {
+    await userEvent.tab();
+    const active = document.activeElement;
+    if (wrapper.contains(active)) {
+      inside += 1;
+    }
+    if (active instanceof HTMLButtonElement && active.textContent === "저장") {
+      reachedSave = true;
+    }
+  }
+  return { inside, reachedSave };
+}
+
+/**
+ * 가리지 않았다(양성 대조). 틀의 `main` 과 화면의 `h1` 안쪽에 위젯의 `main` 과 `h1` 이 들어 axe 의 landmark 규칙 셋에
+ * 걸린다. 포커스가 위젯 안에 들고 위젯의 단추가 역할로 잡혀야, 아래 갈래의 "들지 않는다"와 "잡히지 않는다"가 실제로
+ * 포커스와 역할을 본 것이다.
+ */
+export const InAdminFrame: Story = {
+  render: framed,
+  play: async ({ canvasElement }) => {
+    const canvas = within(canvasElement);
+    const wrapper = await drawnWidget(canvasElement);
+    const { inside, reachedSave } = await tabThrough(wrapper);
+    await expect(inside).toBeGreaterThan(0);
+    await expect(reachedSave).toBe(true);
+    await expect(canvas.queryByRole("img", { name: PREVIEW_LABEL })).toBeNull();
+    await expect(within(wrapper).getByRole("button", { name: "새 대화" })).toBeVisible();
+    await expect(canvas.getAllByRole("main")).toHaveLength(2);
+  },
+};
+
+/** 갈래 A: 바깥은 이름 붙은 그림이고, 안쪽은 `aria-hidden` 과 `inert` 다. */
+export const ShieldedBoth: Story = {
+  args: { shield: "both" },
+  render: framed,
+  play: async ({ canvasElement }) => {
+    const canvas = within(canvasElement);
+    const wrapper = await drawnWidget(canvasElement);
+    const { inside } = await tabThrough(wrapper);
+    await expect(inside).toBe(0);
+    await expect(canvas.getByRole("img", { name: PREVIEW_LABEL })).toBe(wrapper);
+    await expect(within(wrapper).queryAllByRole("button")).toHaveLength(0);
+    await expect(canvas.getAllByRole("main")).toHaveLength(1);
+  },
+};
+
+/**
+ * 갈래 B: 안쪽이 `inert` 뿐이다.
+ *
+ * 역할로 찾는 testing-library 는 `inert` 를 보지 않아(`@testing-library/dom` 10.4.2 의 `dist/role-helpers.js` 33~78줄을
+ * 읽었다. `hidden`, `aria-hidden="true"`, `display: none`, `visibility: hidden` 만 본다) 위젯의 단추와 `main` 을 그대로
+ * 찾는다. 브라우저의 접근성 트리가 그것을 내는지는 프로브 `preview_shield.mjs` 가 본다.
+ */
+export const ShieldedInert: Story = {
+  args: { shield: "inert" },
+  render: framed,
+  play: async ({ canvasElement }) => {
+    const canvas = within(canvasElement);
+    const wrapper = await drawnWidget(canvasElement);
+    const { inside } = await tabThrough(wrapper);
+    await expect(inside).toBe(0);
+    await expect(canvas.getByRole("img", { name: PREVIEW_LABEL })).toBe(wrapper);
+    await expect(within(wrapper).queryAllByRole("button")).toHaveLength(3);
+    await expect(canvas.getAllByRole("main")).toHaveLength(2);
+  },
+};
+
+/**
+ * 갈래 C: 안쪽이 `aria-hidden` 뿐이다(포커스의 대조). 포커스가 위젯 안에 들어야 위 두 갈래의 "들지 않는다"가 `inert`
+ * 때문이다.
+ */
+export const ShieldedHidden: Story = {
+  args: { shield: "hidden" },
+  render: framed,
+  play: async ({ canvasElement }) => {
+    const canvas = within(canvasElement);
+    const wrapper = await drawnWidget(canvasElement);
+    const { inside, reachedSave } = await tabThrough(wrapper);
+    await expect(inside).toBeGreaterThan(0);
+    await expect(reachedSave).toBe(true);
+    await expect(canvas.getByRole("img", { name: PREVIEW_LABEL })).toBe(wrapper);
+    await expect(within(wrapper).queryAllByRole("button")).toHaveLength(0);
+    await expect(canvas.getAllByRole("main")).toHaveLength(1);
+  },
+};
+
+// 아래 넷은 미리보기의 높이를 넘는 내용이다. 가리지 않은 것(대조)과 갈래 A 를 긴 안내와 긴 대화로 그린다. 휠과 클릭은
+// 프로브 `preview_shield.mjs` 가 실제 마우스로 본다. 여기서는 그려졌다는 것과 넘쳤다는 것만 단언한다. 틀의 끝에 빈 높이를
+// 둬 페이지도 스크롤되게 한다. 위젯이 받지 않은 휠이 페이지로 넘어가는지를 그 프로브가 본다.
+
+function framedTall(args: WidgetPreviewProbeProps) {
+  return (
+    <AdminFrame nav={null}>
+      <h1 className="text-title">사이트 고치기</h1>
+      <WidgetPreviewProbe {...args} />
+      <Button variant="secondary">저장</Button>
+      <div style={{ height: 1200 }} />
+    </AdminFrame>
+  );
+}
+
+/** 위젯이 그려졌고 그 안의 `selector` 자리가 넘쳤다(`scrollHeight` 가 `clientHeight` 보다 크다)는 표지를 본다. */
+async function overflowing(canvasElement: HTMLElement, selector: string): Promise<HTMLElement> {
+  const wrapper = await drawnWidget(canvasElement);
+  const scroller = wrapper.querySelector(selector);
+  if (!(scroller instanceof HTMLElement)) {
+    throw new Error(`스크롤하는 자리 ${selector} 를 찾지 못했다`);
+  }
+  await expect(scroller.scrollHeight).toBeGreaterThan(scroller.clientHeight);
+  return scroller;
+}
+
+/** 대조: 가리지 않았고 첫 화면의 안내가 길다. 위젯의 `main` 이 넘친다. */
+export const LongIntroInAdminFrame: Story = {
+  args: { long: "intro" },
+  render: framedTall,
+  play: async ({ canvasElement }) => {
+    await overflowing(canvasElement, "main");
+  },
+};
+
+/** 갈래 A 에 긴 안내. */
+export const LongIntroShielded: Story = {
+  args: { long: "intro", shield: "both" },
+  render: framedTall,
+  play: async ({ canvasElement }) => {
+    await overflowing(canvasElement, "main");
+  },
+};
+
+/** 대조: 가리지 않았고 대화가 길다. `main` 안의 대화 영역이 넘친다. */
+export const LongTalkInAdminFrame: Story = {
+  args: { long: "talk" },
+  render: framedTall,
+  play: async ({ canvasElement }) => {
+    await overflowing(canvasElement, '[aria-label="대화"]');
+  },
+};
+
+/** 갈래 A 에 긴 대화. */
+export const LongTalkShielded: Story = {
+  args: { long: "talk", shield: "both" },
+  render: framedTall,
+  play: async ({ canvasElement }) => {
+    await overflowing(canvasElement, '[aria-label="대화"]');
+  },
+};
diff --git a/web/apps/admin/components/pages/WidgetPreviewProbe.tsx b/web/apps/admin/components/pages/WidgetPreviewProbe.tsx
new file mode 100644
index 000000000..7c8fe8fa4
--- /dev/null
+++ b/web/apps/admin/components/pages/WidgetPreviewProbe.tsx
@@ -0,0 +1,133 @@
+"use client";
+
+// (portal-admin 의 프로브 shared_widget_parts 가 둔 임시 파일. 병합하지 않는다.) 다른 앱이 `@agent-os/widget-ui` 의
+// `WidgetScreen` 을 값만 주어 그릴 수 있는지 본다. 서버에 묻지 않는다. 처리기는 "새 대화"만 불린 횟수를 세고 나머지는
+// 아무것도 하지 않는다. 위젯이 문서 뿌리나 shadow 호스트에 다는 테마·모드·보통 밀도를 여기서는 감싼 요소에 단다. 관리
+// 화면의 문서 뿌리는 밀도를 달지 않아 창 폭이 고른다.
+//
+// 앱의 전역 CSS 와 글꼴 CSS 는 AdminScreen 처럼 여기서 싣는다. 이 화면은 AdminScreen 을 지나지 않는다.
+import "@agent-os/ui/fonts.css";
+import "../../styles/admin.css";
+import { WidgetScreen, type Exchange } from "@agent-os/widget-ui";
+import { useState } from "react";
+
+const EXCHANGES: readonly Exchange[] = [
+  {
+    id: 0,
+    request: "주문 1234 는 어디쯤인가요?",
+    runId: "run-preview",
+    calling: [],
+    tools: [{ tool: "orders.find", ok: true }],
+    approvals: [],
+    outcome: { kind: "finished", output: "**배송 중**입니다. 내일 도착합니다." },
+  },
+];
+
+const INTRO = "주문, 배송, 환불을 물어볼 수 있습니다.";
+
+// 긴 내용 둘. 첫 화면의 긴 안내는 위젯의 `main` 을 넘치게 하고, 긴 대화는 그 안의 대화 영역을 넘치게 한다(그 영역이
+// 스크롤하는 자리다. `@agent-os/widget-ui` 의 organisms/Conversation).
+const LONG_INTRO = Array.from(
+  { length: 40 },
+  (_, line) => `안내 ${String(line + 1)}번째 줄입니다. 주문, 배송, 환불을 물어볼 수 있습니다.`,
+).join(" ");
+
+function longExchange(id: number): Exchange {
+  return {
+    id,
+    request: `주문 ${String(1000 + id)} 은 어디쯤인가요?`,
+    runId: `run-preview-${String(id)}`,
+    calling: [],
+    tools: [],
+    approvals: [],
+    outcome: {
+      kind: "finished",
+      output: `주문 ${String(1000 + id)} 은 배송 중입니다. 내일 도착합니다.`,
+    },
+  };
+}
+
+const LONG_TALK: readonly Exchange[] = Array.from({ length: 12 }, (_, id) => longExchange(id));
+
+const ignore = () => {};
+
+const SIZE = { maxWidth: 320, height: 560 };
+
+/** 가린 미리보기가 화면 읽기 프로그램에 읽히는 한 줄(portal-admin 명세 "미리보기"). */
+export const PREVIEW_LABEL = "미리보기, 저장하지 않은 값으로 그린 위젯";
+
+export interface WidgetPreviewProbeProps {
+  /** 감싼 요소에 다는 밝기. 문서 뿌리의 밝기와 달라도 위젯만 이 밝기로 칠해지는지 본다. */
+  readonly mode?: "light" | "dark";
+  /**
+   * 미리보기를 보기만 하는 그림으로 가리는 방법. 없으면 가리지 않는다. 가리면 바깥 요소가 이름 붙은 그림(`role="img"`)이
+   * 되고, 위젯을 감싼 안쪽 요소가 `both` 는 `aria-hidden` 과 `inert` 를, `inert` 와 `hidden` 은 그 하나만 갖는다. 옮긴
+   * 부품(`@agent-os/widget-ui`)은 고치지 않는다.
+   */
+  readonly shield?: "both" | "inert" | "hidden";
+  /** 미리보기의 높이를 넘는 내용. `intro` 는 첫 화면의 긴 안내, `talk` 는 긴 대화다. 없으면 교환 하나다. */
+  readonly long?: "intro" | "talk";
+}
+
+export function WidgetPreviewProbe({ mode = "light", shield, long }: WidgetPreviewProbeProps) {
+  // "새 대화"의 처리기가 불린 횟수. 감싼 바깥 요소의 `data-new-conversation-calls` 로 낸다(프로브가 읽는다).
+  const [calls, setCalls] = useState(0);
+  const screen = (
+    <WidgetScreen
+      heading="주문 도우미"
+      intro={long === "intro" ? LONG_INTRO : INTRO}
+      misconfigured={false}
+      exchanges={long === "intro" ? [] : long === "talk" ? LONG_TALK : EXCHANGES}
+      restarted={false}
+      announcements={[]}
+      sendBlocked={false}
+      wait={null}
+      invalid={false}
+      paused={false}
+      onDecide={ignore}
+      newConversationDisabled={false}
+      draft=""
+      onDraftChange={ignore}
+      onSend={ignore}
+      onRetry={ignore}
+      onNewConversation={() => {
+        setCalls((count) => count + 1);
+      }}
+      requestChars={20_000}
+      restore="ready"
+      reconnect={null}
+    />
+  );
+  if (shield === undefined) {
+    return (
+      <div
+        data-theme="nokcheong"
+        data-mode={mode}
+        data-density="regular"
+        data-new-conversation-calls={calls}
+        style={SIZE}
+      >
+        {screen}
+      </div>
+    );
+  }
+  return (
+    <div
+      role="img"
+      aria-label={PREVIEW_LABEL}
+      data-theme="nokcheong"
+      data-mode={mode}
+      data-density="regular"
+      data-new-conversation-calls={calls}
+      style={SIZE}
+    >
+      <div
+        aria-hidden={shield === "inert" ? undefined : true}
+        inert={shield !== "hidden"}
+        style={{ height: "100%" }}
+      >
+        {screen}
+      </div>
+    </div>
+  );
+}
diff --git a/web/apps/admin/package.json b/web/apps/admin/package.json
