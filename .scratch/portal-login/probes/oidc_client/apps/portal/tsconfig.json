{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*",
    "tools/**/*",
    "testing/**/*",
    "browser/**/*",
    "e2e/**/*",
    "playwright.config.ts",
    "playwright.config.test.ts"
  ]
}
